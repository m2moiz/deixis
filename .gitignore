# scratch/ holds working DATA -- recordings, transcripts, gate run dirs. That is
# what is ignored. The scripts in it are code and are tracked: resume_gate.py and
# diarize_gate.py are the only checks that catch a silently-restarting resume or
# a skipped diarization pass, and an untracked check is a check nobody runs.
scratch/*
!scratch/*.py
!scratch/*.sh

.venv/
__pycache__/
# Build output, produced by `uv build`. Source is tracked; artifacts are not.
dist/
*.wav
*.mov

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Planning docs stay local (global pre-commit hook denies AI tooling files)
.planning/

# Coverage output and pytest caches are artifacts, not source.
.coverage

# Machine-local git hooks. core.hooksPath points here, so they are LIVE --
# but they hardcode absolute interpreter paths for this machine and named
# another project on disk. They are not source; they do not belong in a repo.
.beads/hooks/

# mutmut writes its mutants and results here.
mutants/
.mutmut-cache
